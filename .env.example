# ClearSplit Environment Configuration Template
# =============================================
# 
# SECURITY WARNING: NEVER commit real secrets to git!
# This file contains ONLY placeholders. Copy to .env.local and fill with real values.
#
# Setup Instructions:
#   1. cp .env.example .env.local
#   2. Generate JWT_SECRET: openssl rand -hex 32
#   3. Fill in your DATABASE_URL with actual credentials
#   4. Never commit .env.local (it's gitignored)

# --- Required Configuration ---

# Environment: local, test, staging, or production
ENV=local

# PostgreSQL Database Connection
# Format: postgresql+asyncpg://username:password@host:port/database?sslmode=require
# Local example: postgresql+asyncpg://clearsplit:YOUR_DB_PASSWORD_HERE@localhost:5432/clearsplit
# Azure PG example: postgresql+asyncpg://clearsplit_admin:YOUR_DB_PASSWORD_HERE@YOUR_SERVER.postgres.database.azure.com:5432/clearsplit?sslmode=require
DATABASE_URL=postgresql+asyncpg://clearsplit:YOUR_DB_PASSWORD_HERE@localhost:5432/clearsplit

# Optional Docker Compose API DB override.
# When set, docker-compose api service uses this value instead of the local `db` container URL.
# Useful for iOS simulator -> local API -> AWS RDS flows.
API_DATABASE_URL=

# JWT Secret Key (CRITICAL: Generate a strong random secret!)
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# --- Optional Configuration (with defaults) ---

# JWT Algorithm
JWT_ALGORITHM=HS256

# Token Expiration Times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS / proxy / rate limit
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
RATE_LIMIT_MAX_KEYS=10000

# Database pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# S3 / OCR settings
AWS_REGION=us-east-2
S3_BUCKET_NAME=YOUR_S3_BUCKET_NAME_HERE
S3_PRESIGNED_GET_EXPIRE_SECONDS=900
S3_PREFIX=receipts
MAX_RECEIPT_BYTES=10485760
MAX_RECEIPT_PIXELS=25000000
MAX_OCR_CONCURRENCY=2

# Optional for local/static-key S3 auth.
# In Azure production prefer managed identity or platform secret injection.
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE

# --- Redis / Celery / Caching ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=60
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
PROMETHEUS_ENABLED=true

# --- PostgreSQL Container Config (for docker-compose) ---

POSTGRES_USER=clearsplit
POSTGRES_PASSWORD=YOUR_DB_PASSWORD_HERE
POSTGRES_DB=clearsplit
POSTGRES_PORT=5432

# --- Notes ---
# 
# For production deployments:
# - Use GitHub Secrets or your platform's secret management
# - Ensure ENV=production
# - Use strong, randomly generated secrets (64+ chars recommended for JWT_SECRET)
# - Keep DATABASE_URL on TLS (`sslmode=require` for Azure PostgreSQL)
# - Rotate secrets regularly
# 
# For local development:
# - Use .env.local (gitignored)
# - You can use simpler passwords locally, but NEVER in production
# 
# For CI/CD:
# - Tests use dummy secrets injected by GitHub Actions
# - See .github/workflows/ci.yml for test configuration
